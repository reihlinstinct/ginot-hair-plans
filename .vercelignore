# The Vercel project ships only the api/ email function; the site itself is
# served by GitHub Pages. Without this, the function bundle includes the
# repo's data/PDFs and exceeds the 500 MB function limit.
data/
plans/
docs/
out/
snapshots/
reference/
releases/
design/
man/
worker/
tests/
scripts/
# src/ is excluded except the one strings document the mail API reads
# (gitignore rules: a file can only be re-included if its parents are).
src/*
!src/ginot/
src/ginot/*
!src/ginot/i18n/
src/ginot/i18n/*
!src/ginot/i18n/strings.json
.github/
